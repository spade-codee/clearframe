<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClearFrame — Your offline library" Width="1280" Height="920" MinWidth="1080" MinHeight="800" WindowStartupLocation="CenterScreen" Background="#090909" Foreground="#F4F4EF" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A2AA94"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#262823"/><Setter Property="Foreground" Value="#F4F4EF"/><Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#090909"/><Setter Property="Foreground" Value="#F4F4EF"/><Setter Property="CaretBrush" Value="#D6F64A"/><Setter Property="BorderBrush" Value="#3C4230"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F4EF"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="#22251F" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#414E28"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#D6F64A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F4F4EF"/><Setter Property="MinHeight" Value="36"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#242721" CornerRadius="6" BorderBrush="#465038" BorderThickness="1"><TextBlock Text="⌄" Foreground="#D6F64A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,2"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,7,27,7" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#22251F" BorderBrush="#626F41" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D5DCCA"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ListView"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F4F4EF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="#191B17" BorderBrush="#343D27" BorderThickness="1" CornerRadius="8" Padding="14,12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#D6F64A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#D6F64A"/><Setter Property="Foreground" Value="#111609"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="10,10"/><Setter Property="Background" Value="Transparent"/></Style>
 </Window.Resources>
 <Grid x:Name="Root"><Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111111" BorderBrush="#2D3425" BorderThickness="0,0,1,0" Padding="20,28,20,22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="#D6F64A" CornerRadius="10" Width="43" Height="43" HorizontalAlignment="Left"><TextBlock Text="↓" Foreground="#111609" FontSize="29" FontWeight="Bold" TextAlignment="Center"/></Border><TextBlock Text="clearframe" FontSize="23" FontWeight="Bold" Margin="0,12,0,0"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Ellipse Fill="#FF625B" Width="5" Height="5" Margin="0,0,6,0"/><TextBlock Text="THE OFFLINE EDITION" FontSize="9" Foreground="#A5AE94"/></StackPanel></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,24,0,0"><TextBlock Text="YOUR SPACE" Foreground="#84936E" FontSize="10" Margin="10,0,0,12"/><Button x:Name="AllNav" Style="{StaticResource Nav}" Content="▦   All downloads"/><Button x:Name="ActiveNav" Style="{StaticResource Nav}" Content="↓   In progress"/><Button x:Name="CompleteNav" Style="{StaticResource Nav}" Content="✓   Completed"/><Button x:Name="AudioNav" Style="{StaticResource Nav}" Content="♫   Audio library"/><Button x:Name="FailedNav" Style="{StaticResource Nav}" Content="!   Needs attention"/><Border Height="1" Background="#2B3521" Margin="0,18"/><Button x:Name="BatchButton" Content="＋  Add a batch" Style="{StaticResource Nav}"/><Button x:Name="OpenFolderButton" Content="↗   Download folder" Style="{StaticResource Nav}"/></StackPanel>
   <StackPanel Grid.Row="3"><Border Background="#1D2612" CornerRadius="9" BorderBrush="#414F2C" BorderThickness="1" Padding="13"><StackPanel><TextBlock Text="SOURCE QUALITY" Foreground="#D6F64A" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Real quality.&#x0a;Up to 8K." Margin="0,7,0,9" FontSize="13"/><TextBlock Text="No upscaling. No silent downgrades." FontSize="11" Foreground="#A9B791"/></StackPanel></Border><Button x:Name="UpdateButton" Content="↻  Update engine" Background="Transparent" Margin="0,13,0,5"/><TextBlock x:Name="EngineStatus" Text="v0.2  /  WINDOWS x64" FontSize="9" Foreground="#899975" HorizontalAlignment="Center"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="28,23,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,21"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR LIBRARY, WITHOUT THE BUFFERING." FontSize="10" Foreground="#A3B38C"/><TextBlock Text="Make it yours. Keep it offline." FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Margin="20,0"><TextBlock x:Name="TotalCount" Text="00" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="IN LIBRARY" Foreground="#9FAE89" FontSize="9"/></StackPanel><Border Width="1" Background="#3A442C" Margin="0,6,0,6"/><StackPanel Margin="20,0,0,0"><TextBlock x:Name="DoneCount" Text="00" Foreground="#D6F64A" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="COMPLETE" Foreground="#9FAE89" FontSize="9"/></StackPanel></StackPanel></Grid>
   <Border Grid.Row="1" Background="#181A16" BorderBrush="#3B4230" BorderThickness="1" CornerRadius="12" Padding="20,17"><StackPanel>
    <Grid><TextBlock Text="A link today. A library for later." FontSize="17" FontWeight="SemiBold"/><TextBlock Text="01  /  CAPTURE" HorizontalAlignment="Right" Foreground="#B1C196" FontSize="10" VerticalAlignment="Center"/></Grid>
    <TextBlock Text="Paste a video link, or add a batch from the sidebar." Foreground="#A8B695" FontSize="12" Margin="0,5,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="UrlBox" AutomationProperties.Name="YouTube video URL" ToolTip="Ctrl+L to focus. Paste a YouTube video or Shorts link."/><TextBlock Text="Paste a YouTube link…" Foreground="#919B82" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=UrlBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button x:Name="PasteButton" Grid.Column="1" Content="Paste" Margin="8,0,0,0"/><Button x:Name="InspectButton" Grid.Column="2" Content="Check link  ↗" Style="{StaticResource Primary}" Margin="8,0,0,0"/></Grid>
    <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="RESOLUTION" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,0,0,6"/><ComboBox x:Name="QualityBox" SelectedIndex="0" AutomationProperties.Name="Resolution"><ComboBoxItem Content="1080p · Full HD"/><ComboBoxItem Content="1440p · QHD"/><ComboBoxItem Content="2160p · 4K"/><ComboBoxItem Content="4320p · 8K"/><ComboBoxItem Content="Best source · no cap"/><ComboBoxItem Content="720p · HD"/><ComboBoxItem Content="480p"/><ComboBoxItem Content="360p"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="FILE FORMAT" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,0,0,6"/><ComboBox x:Name="FormatBox" SelectedIndex="0" AutomationProperties.Name="File format"><ComboBoxItem Content="MP4 · modern video"/><ComboBoxItem Content="MP4 · compatible H.264"/><ComboBoxItem Content="MKV · best codecs"/><ComboBoxItem Content="WebM · VP9 / AV1"/><ComboBoxItem Content="MOV · H.264 + AAC"/><ComboBoxItem Content="MP3 · audio / best VBR"/><ComboBoxItem Content="M4A · audio / AAC"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="SPEED LIMIT" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,0,0,6"/><ComboBox x:Name="SpeedBox" SelectedIndex="0" AutomationProperties.Name="Download speed limit"><ComboBoxItem Content="Unlimited"/><ComboBoxItem Content="1 MiB / second"/><ComboBoxItem Content="2 MiB / second"/><ComboBoxItem Content="5 MiB / second"/><ComboBoxItem Content="10 MiB / second"/></ComboBox></StackPanel>
    </Grid>
    <WrapPanel Margin="0,13,0,0"><CheckBox x:Name="FallbackBox" Content="Allow lower resolution" FontSize="12" Margin="0,0,23,0"/><CheckBox x:Name="SubtitleBox" Content="English subtitles (.srt)" FontSize="12"/></WrapPanel>
    <TextBlock x:Name="FormatHint" Text="Keeps the original picture and sound. Your player must support the source codec." FontSize="11" Foreground="#A0B18A" Margin="0,10,0,0"/>
    <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SAVE TO" Foreground="#A0B18A" FontSize="9" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="FolderText" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/><Button x:Name="FolderButton" Grid.Column="2" Content="Change" Padding="12,6" FontSize="11"/></Grid>
   </StackPanel></Border>
   <Border Grid.Row="2" Background="#222916" BorderBrush="#526D29" BorderThickness="1" CornerRadius="9" Margin="0,12,0,20" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="↙" Foreground="#D6F64A" FontSize="30" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock x:Name="PreviewTitle" Text="Your next great watch starts here." FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="PreviewDetail" Text="Check a link to see its title, quality and estimated size." Foreground="#B0C198" FontSize="11" Margin="0,4,0,0" MaxHeight="44"/></StackPanel><Button x:Name="AddButton" Grid.Column="2" Content="＋  Add to queue" Style="{StaticResource Primary}" IsEnabled="False" VerticalAlignment="Center"/></Grid></Border>
   <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="225"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LibraryTitle" Text="All downloads" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="QueueCount" Text="0 items · Ready when you are" Foreground="#9DB084" FontSize="10" Margin="0,3,0,0"/></StackPanel><Grid Grid.Column="1" VerticalAlignment="Center"><TextBox x:Name="SearchBox" AutomationProperties.Name="Search your library" ToolTip="Search by title, link or file format. Ctrl+F" Padding="10,8"/><TextBlock Text="⌕  Search library" Foreground="#919B82" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
    <ListView x:Name="QueueList" Grid.Row="1" AutomationProperties.Name="Download library"><ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Border CornerRadius="6" Background="#303922" Padding="4,9" Margin="0,0,12,0" VerticalAlignment="Center"><StackPanel><TextBlock Text="{Binding Badge}" TextAlignment="Center" Foreground="#D6F64A" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Kind}" TextAlignment="Center" Foreground="#B1C198" FontSize="8" Margin="0,3,0,0"/></StackPanel></Border><StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#B0BC9F" FontSize="11" Margin="0,5,0,0" MaxHeight="31" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" HorizontalAlignment="Right" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D6F64A"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="#FF756E"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Stopped"><Setter Property="Foreground" Value="#B4BEA5"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ProgressBar Value="{Binding Progress}" Height="3" Margin="0,8,0,0" Foreground="#D6F64A" Background="#3B4B2A" BorderThickness="0"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
    <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="↓" Foreground="#778E4C" FontSize="32" TextAlignment="Center"/><TextBlock x:Name="EmptyText" Text="A little space for your next obsession." TextAlignment="Center" Foreground="#BAC8A5" FontSize="13" Margin="0,7,0,0"/><TextBlock Text="Add a link or a batch to get started." TextAlignment="Center" Foreground="#96A77D" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="↓  Start queue" Style="{StaticResource Primary}" Margin="0,0,7,0"/><Button x:Name="StopButton" Content="■  Stop" Foreground="#FF827C" Background="#3B1C17" IsEnabled="False" Margin="0,0,7,0"/></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="RetryButton" Content="Retry" Margin="0,0,6,0"/><Button x:Name="PlayButton" Content="▶" Margin="0,0,6,0" ToolTip="Play selected file" AutomationProperties.Name="Play selected file"/><Button x:Name="OpenButton" Content="Show file" Margin="0,0,6,0"/><Button x:Name="UpButton" Content="↑" Padding="11,10" Margin="0,0,6,0" ToolTip="Move queued item up"/><Button x:Name="DownButton" Content="↓" Padding="11,10" Margin="0,0,6,0" ToolTip="Move queued item down"/><Button x:Name="MoreButton" Content="•••" ToolTip="More library actions"/></WrapPanel></Grid>
   </Grid>
   <Border Grid.Row="4" BorderBrush="#38442A" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,11,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready. Exact quality, with no upscaling or silent downgrades." FontSize="11" Foreground="#B4C39E" MaxHeight="30" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="LOCAL FILES. YOUR CONTROL." FontSize="9" Foreground="#96A77C" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Grid>
</Window>